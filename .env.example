# Written by setup wizard — do not edit manually unless you know what you're doing
DATABASE_URL=postgres://user:pass@localhost:5432/candleserv
DEMO_TOKEN_SECRET=<64-char random hex, auto-generated at setup>
SETUP_COMPLETE=true

# Set before first start if the default port is not suitable
PORT=3007

# Public demo mode (Phase 10) — uncomment on a dedicated demo droplet.
# Runs the live collector against its OWN database; serves a read-only,
# Candles-only page; disables /v1. DEMO_TOKEN_SECRET signs the page token.
# IS_DEMO=true
